# Authentication Configuration 
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-secure-admin-password"
GUEST_EMAIL="guest@yourdomain.com"
GUEST_PASSWORD="your-secure-guest-password"


# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-at-least-32-chars"


# IMAP Configuration for Receiving Emails 
IMAP_HOST="imap.example.com"
IMAP_USER="admin@yourdomain.com"
IMAP_PASSWORD="your-imap-password"
IMAP_PORT="993"
IMAP_MAILBOX="INBOX"
IMAP_MARK_AS_SEEN="false"
IMAP_FETCH_LIMIT="50"

# SMTP Configuration for Outgoing Mail
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="admin@yourdomain.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"


# OpenRouter Configuration
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="anthropic/claude-3-opus:beta"

# Upstash Redis Configuration (Required for Guidescript and Keep-Alive)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Vercel Cron Secret (Optional, for protecting the ping endpoint)
# CRON_SECRET="your-cron-secret"

# Needpedia Integration (for AI chat persistence)
POST_TOKEN="your-post-token"
NEXT_PUBLIC_API_BASE_URL="https://needpedia.org"
